cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_ROOT)
    message(FATAL_ERROR "Asset packaging requires PROJECT_ROOT and OUTPUT_ROOT.")
endif()
file(REAL_PATH "${PROJECT_ROOT}" project_real)
file(REAL_PATH "${OUTPUT_ROOT}" output_real)
cmake_path(IS_PREFIX project_real "${output_real}" NORMALIZE output_inside)
if(NOT output_inside OR output_real STREQUAL project_real)
    message(FATAL_ERROR "Asset output must be a build directory inside the workspace.")
endif()
set(source_native "${project_real}/assets/native")
if(NOT EXISTS "${source_native}")
    message(WARNING "assets/native is absent; prepare game assets with scripts/bootstrap-assets.ps1.")
    return()
endif()

file(GLOB_RECURSE source_files LIST_DIRECTORIES false RELATIVE "${source_native}" "${source_native}/*")
list(SORT source_files)
set(source_records "")
foreach(relative IN LISTS source_files)
    file(SHA256 "${source_native}/${relative}" digest)
    file(SIZE "${source_native}/${relative}" bytes)
    list(APPEND source_records "${relative}|${bytes}|${digest}")
endforeach()

set(stage "${output_real}/.asset-staging")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/native")
file(COPY "${source_native}/" DESTINATION "${stage}/native")
file(GLOB_RECURSE staged_files LIST_DIRECTORIES false RELATIVE "${stage}/native" "${stage}/native/*")
list(SORT staged_files)
set(staged_records "")
set(manifest "{\n  \"schema_version\": 1,\n  \"files\": [")
set(separator "")
foreach(relative IN LISTS staged_files)
    file(SHA256 "${stage}/native/${relative}" digest)
    file(SIZE "${stage}/native/${relative}" bytes)
    list(APPEND staged_records "${relative}|${bytes}|${digest}")
    string(REPLACE "\\" "\\\\" json_path "${relative}")
    string(REPLACE "\"" "\\\"" json_path "${json_path}")
    string(APPEND manifest "${separator}\n    {\"path\": \"assets/native/${json_path}\", \"size_bytes\": ${bytes}, \"sha256\": \"${digest}\"}")
    set(separator ",")
endforeach()
string(APPEND manifest "\n  ]\n}\n")
if(NOT source_records STREQUAL staged_records)
    message(FATAL_ERROR "Native assets changed while packaging; rerun after converters finish. Previous package is preserved.")
endif()
file(MAKE_DIRECTORY "${output_real}/assets")
file(REMOVE_RECURSE "${output_real}/assets/native")
file(RENAME "${stage}/native" "${output_real}/assets/native")
file(REMOVE_RECURSE "${stage}")
file(WRITE "${output_real}/asset-manifest.json" "${manifest}")
